# Mau bien moi truong - copy thanh .env va dien gia tri that. KHONG commit .env.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tdc_app
DB_PASSWORD=
DB_NAME=tdc_qr
DB_SSL=false
# >= 32 ky tu ngau nhien, tao bang: openssl rand -base64 48
JWT_ACCESS_SECRET=
# >= 32 ky tu ngau nhien, KHAC JWT_ACCESS_SECRET: ky cookie thiet bi cua sinh vien (openssl rand -base64 48)
DEVICE_SECRET=
# production: true (cookie Secure). Dev http: false
COOKIE_SECURE=false
# bat khi chay sau nginx/ALB de lay dung IP
TRUST_PROXY=false
# Goc URL trang diem danh cong khai, dung de dung noi dung ma QR (production bat buoc, phai https)
PUBLIC_BASE_URL=http://localhost:5173
# (tuy chon) thu muc chua cum3logo.png de thay logo dong goi san trong PDF ma QR; de trong = dung apps/api/assets/brand
BRAND_DIR=